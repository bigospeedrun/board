# /etc/bigospeedrun/board-auto-deploy.env (0600, root; the directory is 0700). Plain
# KEY=value lines, read by auto-deploy.sh and never run as shell. No secrets here: the
# board's secrets are files in /etc/bigospeedrun/board/ (compose.board.yml).
BOARD_IMAGE_REPO=ghcr.io/bigospeedrun/board
BOARD_GITHUB_REPO=bigospeedrun/board
BOARD_IMAGE_WORKFLOW=image.yml
# Optional: the tag to follow (default main). For a rehearsal: rehearsal-good,
# rehearsal-bad or rehearsal-manual (pushed by .github/workflows/image-rehearsal.yml;
# main never moves).
#BOARD_TAG=main
