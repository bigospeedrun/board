# Race board routes for the board's own host (phase E; not deployed). The board is not
# under the site host. On the VPS this file is /etc/wg-caddy/board-routes.caddy, and the
# site block deploy/board.site.caddy (/etc/wg-caddy/board.caddy) imports it:
#
#   board.bigospeedrun.com {
#   	...
#   	import /etc/wg-caddy/board-routes.caddy
#   }
#
# Only the three public endpoints and the read-only pages pass (GET/HEAD /board/,
# /board/<slug>, /board/assets/*, all from board-api); every other path and method on this
# host is 404. / sends people to the board list.
# Caddy reaches the services through unix sockets in /run/bigospeedrun-board/{api,auth}
# (group wg-caddy). Body caps match the apps: 8 KiB = 8192 bytes, 2 KiB = 2048 bytes.
handle /board/* {
	@post_api {
		method POST
		path /board/api/posts
		header Content-Type application/json*
	}
	handle @post_api {
		request_body {
			max_size 8KiB
		}
		reverse_proxy unix//run/bigospeedrun-board/api/api.sock {
			header_up X-Forwarded-For {client_ip}
		}
	}

	@read_api {
		method GET HEAD
		path /board/api/posts
	}
	handle @read_api {
		reverse_proxy unix//run/bigospeedrun-board/api/api.sock
	}

	@pages {
		method GET HEAD
		path /board/ /board/assets/*
	}
	handle @pages {
		reverse_proxy unix//run/bigospeedrun-board/api/api.sock
	}

	@board_page {
		method GET HEAD
		path_regexp ^/board/[a-z0-9][a-z0-9-]{0,62}$
	}
	handle @board_page {
		reverse_proxy unix//run/bigospeedrun-board/api/api.sock
	}

	@auth_get {
		method GET
		path /board/auth/login /board/auth/callback /board/auth/account /board/auth/
	}
	handle @auth_get {
		reverse_proxy unix//run/bigospeedrun-board/auth/auth.sock
	}

	@auth_post {
		method POST
		path /board/auth/keys /board/auth/keys/revoke /board/auth/logout
	}
	handle @auth_post {
		request_body {
			max_size 2KiB
		}
		reverse_proxy unix//run/bigospeedrun-board/auth/auth.sock
	}

	handle {
		respond 404
	}
}

# The host's root: the board list.
handle / {
	redir * /board/ 302
}

# Everything else outside /board/ on this host.
handle {
	respond 404
}
